# Minimal DeepFM pipeline used by the sample-shuffle torchrun smoke test.
train_input_path: ""
eval_input_path: ""
model_dir: ""
train_config {
    sparse_optimizer {
        adagrad_optimizer { lr: 0.001 }
        constant_learning_rate {}
    }
    dense_optimizer {
        adam_optimizer { lr: 0.001 }
        constant_learning_rate {}
    }
    num_steps: 1
    save_checkpoints_steps: 10
    log_step_count_steps: 10
}
eval_config {}
data_config {
    batch_size: 128
    dataset_type: ParquetDataset
    label_fields: "label"
    num_workers: 2
    fg_mode: FG_NONE
    shuffle: true
    shuffle_mode: SAMPLE_ROLLING
    shuffle_buffer_size: 4
}
feature_configs {
    id_feature { feature_name: "id" num_buckets: 100003 embedding_dim: 8 }
}
model_config {
    feature_groups {
        group_name: "wide"
        feature_names: "id"
        group_type: WIDE
    }
    feature_groups {
        group_name: "deep"
        feature_names: "id"
        group_type: DEEP
    }
    deepfm {
        deep { hidden_units: [32, 16] }
    }
    losses { binary_cross_entropy {} }
    metrics { auc {} }
}
