train_input_path: ""
eval_input_path: ""
model_dir: "experiments/genrec_causal_lm_model_mock"
train_config {
    sparse_optimizer {
        adagrad_optimizer {
            lr: 0.0
        }
        constant_learning_rate {
        }
    }
    dense_optimizer {
        adam_optimizer {
            lr: 0.0001
        }
        constant_learning_rate {
        }
    }
    num_epochs: 1
    save_checkpoints_epochs: 1
    mixed_precision: "BF16"
}
eval_config {
}
export_config {
    mixed_precision: "BF16"
}
data_config {
    batch_size: 4
    dataset_type: ParquetDataset
    fg_mode: FG_DAG
    label_fields: "answer"
    num_workers: 1
}
feature_configs {
    id_feature {
        feature_name: "age"
        expression: "user:age"
        num_buckets: 8
        embedding_dim: 4
    }
}
feature_configs {
    id_feature {
        feature_name: "city"
        expression: "user:city"
        embedding_name: "city_emb"
        num_buckets: 16
        embedding_dim: 8
    }
}
feature_configs {
    id_feature {
        feature_name: "home_city"
        expression: "user:home_city"
        embedding_name: "city_emb"
        num_buckets: 16
        embedding_dim: 8
    }
}
feature_configs {
    id_feature {
        feature_name: "context_id"
        expression: "user:context_id"
        num_buckets: 16
        embedding_dim: 16
    }
}
feature_configs {
    raw_feature {
        feature_name: "score"
        expression: "user:score"
        value_dim: 4
    }
}
feature_configs {
    sequence_feature {
        sequence_name: "hist"
        sequence_length: 2
        sequence_delim: ";"
        features {
            id_feature {
                feature_name: "sid"
                expression: "item:sid_codes"
                value_dim: 3
                num_buckets: 12
            }
        }
    }
}
feature_configs {
    sequence_feature {
        sequence_name: "tags"
        sequence_length: 2
        sequence_delim: ";"
        features {
            id_feature {
                feature_name: "tag_a"
                expression: "item:tag_a_id"
                num_buckets: 16
                embedding_dim: 8
            }
        }
        features {
            id_feature {
                feature_name: "tag_b"
                expression: "item:tag_b_ids"
                num_buckets: 16
                embedding_dim: 4
                value_dim: 0
                pooling: "mean"
            }
        }
        features {
            tokenize_feature {
                feature_name: "text"
                expression: "item:text_raw"
                embedding_dim: 8
            }
        }
    }
}
feature_configs {
    tokenize_feature {
        feature_name: "title"
        expression: "user:title"
        tokens_as_sequence: true
        sequence_length: 4
    }
}
prompt_config {
    tokenizer_path: "data/test/tokenizer.json"
    prompt: "User : {{profile}} Context : {{ctx}} History : {{hist__sid}} . Tags : {{hist_tags}} Title : {{title}} Predict :"
    response: "{{answer}}"
    slots {
        name: "profile"
        feature_names: "age"
        feature_names: "city"
        feature_names: "home_city"
        projection {
            bias: true
        }
        projection_name: "user_proj"
    }
    slots {
        name: "ctx"
        feature_names: "context_id"
        feature_names: "score"
        projection {
            bias: true
        }
        projection_name: "user_proj"
    }
    slots {
        name: "hist_tags"
        feature_names: "tags__tag_a"
        feature_names: "tags__tag_b"
        feature_names: "tags__text"
        projection {
            mlp {
                hidden_units: 16
            }
            bias: false
        }
    }
    sid_space {
        codebook: 4
        codebook: 4
        codebook: 4
    }
    max_length: 64
}
model_config {
    genrec_causal_lm_model {
        hf_model_name_or_path: "Qwen/Qwen2.5-0.5B"
        common {
            beam_widths: 2
            beam_widths: 2
            beam_widths: 2
            num_return_sequences: 2
        }
    }
}
